# API
API_KEY=dev-api-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# LLM（显式 base_url；Windows 建议 trust_env=False，见 llm/model.py）
#
# --- 方案 A：GLM-5（课程/此前跑通日志用的 edgefn 中转）---
# OPENAI_BASE_URL=https://api.edgefn.net/v1
# OPENAI_API_KEY=你的-edgefn-或兼容密钥
# OPENAI_MODEL=GLM-5
#
# --- 方案 B：阿里百炼 Qwen（compatible-mode）---
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your-dashscope-key
OPENAI_MODEL=qwen-max
OPENAI_TIMEOUT_SEC=120

# 调试：RUNNER_DEBUG=1 时打印 astream 全量 chunk
RUNNER_DEBUG=0

# Tavily
TAVILY_API_KEY=your-tavily-key

# MySQL xiaoneng_db（建议只读账号）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=password
MYSQL_DATABASE=xiaoneng_db

# RAGFlow（V2 接入，MVP 可留空）
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# Limits
MAX_UPLOAD_MB=20
TASK_TIMEOUT_SEC=600
PROMPT_VERSION=v1

# Agent 状态库（TaskStore + LangGraph checkpoint，与业务 MySQL 分离）
# 本地：docker compose up -d postgres 后使用下方连接串
AGENT_DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_db
TASK_STORE_BACKEND=postgres
CHECKPOINTER_BACKEND=postgres
