# API
API_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM（显式 base_url；Windows 建议 trust_env=False，见 llm/model.py）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=120

# 调试：RUNNER_DEBUG=1 时打印 astream 全量 chunk
RUNNER_DEBUG=0

# Tavily
TAVILY_API_KEY=your-tavily-key

# MySQL xiaoneng_db（建议只读账号）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=password
MYSQL_DATABASE=xiaoneng_db

# RAGFlow（V2 接入，MVP 可留空）
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# Limits
MAX_UPLOAD_MB=20
TASK_TIMEOUT_SEC=600
PROMPT_VERSION=v1
